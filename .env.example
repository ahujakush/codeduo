# =====================================================================
# AI Problem Solver Configuration
# =====================================================================

# 1. Telegram Bot Token (Obtained from @BotFather on Telegram)
# Example: 1234567890:ABCdefGHIjklMNOpqrSTUvwxyz1234567

# 2. Preferred AI Provider: "gemini", "openai", "groq", or "mock" (offline test)
AI_PROVIDER=gemini

# 3. Google Gemini Configuration (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 4. OpenAI Configuration (Optional, if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 5. Groq Configuration (Optional, high-speed Llama 3.3)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 6. Bot Behavior & Memory Settings
# Default persona: solver, coder, math, tutor, concise
DEFAULT_PERSONA=solver
# Number of past conversation turns to retain per chat
MAX_MEMORY_TURNS=10

# 7. Access Control (Optional)
# Comma-separated Telegram User IDs allowed to use the bot. Leave empty for all users.
